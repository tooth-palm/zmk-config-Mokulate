#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
            &mo 2      &none     &none    &kp BSPC   &lt 1 BSPC  &kp RET    &mt LALT SPACE  &kp LCTRL  &none  &none  &none  &mo 3
            &kp RSHFT  &kp FSLH  &kp DOT  &kp COMMA  &kp M       &kp N      &kp B           &kp V      &kp C  &kp X  &kp Z  &kp LSHFT
            &kp SQT    &kp SEMI  &kp L    &kp K      &kp J       &kp H      &kp G           &kp F      &kp D  &kp S  &kp A  &kp LGUI
            &kp MINUS  &kp P     &kp O    &kp I      &kp U       &kp Y      &kp T           &kp R      &kp E  &kp W  &kp Q  &kp TAB
            >;
        };

        lower_layer {
            bindings = <
            &kp CAPS   &none     &none      &trans  &trans    &trans      &trans  &trans  &trans  &none   &none   &kp ESC
            &kp RSHFT  &kp BSLH  &none      &none   &none     &none       &none   &none   &none   &none   &none   &kp LSHFT
            &kp RBKT   &kp LBKT  &kp RIGHT  &kp UP  &kp DOWN  &kp LEFT    &none   &none   &none   &none   &none   &kp LGUI
            &kp EQUAL  &kp N0    &kp N9     &kp N8  &kp N7    &kp N6      &kp N5  &kp N4  &kp N3  &kp N2  &kp N1  &kp GRAVE
            >;
        };

        raise_layer {
            bindings = <
            &none    &none    &none    &none   &none   &none     &none   &none   &none   &none   &none   &none
            &none    &none    &none    &none   &none   &none     &none   &none   &none   &none   &none   &none
            &none    &none    &none    &none   &none   &none     &none   &none   &none   &none   &none   &none
            &kp F12  &kp F11  &kp F10  &kp F9  &kp F8  &kp F7    &kp F6  &kp F5  &kp F4  &kp F3  &kp F2  &kp F1
            >;
        };

        bt_layer {
            bindings = <
            &none  &none  &none  &none  &none  &none    &none         &none         &none         &none         &none         &none
            &none  &none  &none  &none  &none  &none    &none         &none         &none         &none         &none         &none
            &none  &none  &none  &none  &none  &none    &none         &none         &none         &none         &none         &studio_unlock
            &none  &none  &none  &none  &none  &none    &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &bt BT_CLR
            >;
        };
    };
};
